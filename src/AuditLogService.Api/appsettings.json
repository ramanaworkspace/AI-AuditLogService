{
  "ConnectionStrings": {
    "AuditLogDatabase": "Host=localhost;Port=5432;Database=AuditLogDb;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Retention": {
    "Window": "90.00:00:00"
  },
  "Redaction": {
    "SensitivePaths": [ "/accountNumber", "/personalId" ]
  }
}
